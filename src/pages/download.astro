---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  latest,
  legacy,
  url,
  size,
  LATEST_VERSION,
  LEGACY_VERSION,
  PLAY_STORE_URL,
  JRE_DOWNLOAD_URL,
} from '../data/downloads';

const tabs = [
  { id: 'windows', label: 'Windows' },
  { id: 'macos', label: 'macOS' },
  { id: 'linux', label: 'Linux' },
  { id: 'android', label: 'Android' },
];

const btn =
  'inline-flex items-center justify-center gap-2 rounded-full bg-accent px-7 py-3 font-display text-sm font-bold tracking-wide text-white shadow-sm transition-colors hover:bg-accent-dark';
---

<BaseLayout
  title="Download – Torii SRS"
  description={`Download Torii SRS ${LATEST_VERSION} free for Windows, macOS, Linux and Android. No Java Runtime Environment required.`}
>
  <PageHeader title="Download" />

  <section class="mx-auto max-w-4xl px-5 py-14">
    <header class="text-center">
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">
        Torii SRS — Latest Version
      </h2>
      <p class="mt-2 font-display text-xl font-bold text-accent-deep">
        Version {LATEST_VERSION}
      </p>
    </header>

    <!-- JRE notice -->
    <div class="mt-9 rounded-lg border border-accent/30 bg-accent/5 p-5">
      <p class="font-display font-bold text-ink">
        JRE no longer required from Version {LATEST_VERSION}
      </p>
      <p class="mt-2 text-sm leading-relaxed">
        Torii SRS now comes with its own built-in, lightweight Java Runtime Environment (JRE). You no
        longer need to install a separate JRE. If you already have one just for Torii, you can safely
        remove it.
      </p>
    </div>

    <!-- CSS-only tabs: one radio per panel, shown with a :checked ~ sibling selector.
         The script below adds hash deep-linking. -->
    <div class="mt-11 download-tabs">
      {
        tabs.map((tab, i) => (
          <input
            type="radio"
            name="platform"
            id={`tab-${tab.id}`}
            class="sr-only"
            checked={i === 0}
          />
        ))
      }

      <div role="tablist" class="flex flex-wrap justify-center gap-2 border-b border-black/10 pb-3">
        {
          tabs.map((tab) => (
            <label
              for={`tab-${tab.id}`}
              data-tab={tab.id}
              class="cursor-pointer rounded-full px-5 py-2 font-display text-sm font-bold text-body transition-colors hover:text-ink"
            >
              {tab.label}
            </label>
          ))
        }
      </div>

      <!-- Windows -->
      <div data-panel="windows" class="pt-9 text-center">
        <h3 class="font-display text-2xl font-bold text-ink">EXE (Portable)</h3>
        <div class="mt-6">
          {
            latest.windows.map((b) => (
              <a href={url(b)} class={btn}>
                {b.label}
                <span class="font-sans text-xs font-normal opacity-80">({size(b)})</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- macOS -->
      <div data-panel="macos" class="pt-9 text-center">
        <h3 class="font-display text-2xl font-bold text-ink">DMG Image</h3>
        <p class="mt-2 text-sm text-muted">Minimum: macOS 10.12 (Sierra)</p>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {
            latest.macos.map((b) => (
              <a href={url(b)} class={btn}>
                {b.label}
                <span class="font-sans text-xs font-normal opacity-80">({size(b)})</span>
              </a>
            ))
          }
        </div>

        <div class="mx-auto mt-8 max-w-lg rounded-lg bg-surface p-5 text-left">
          <p class="text-sm">
            You must run the following command in a Terminal after downloading Torii:
          </p>
          <code
            class="mt-2 block overflow-x-auto rounded bg-dark px-3 py-2 font-mono text-sm text-white"
            >xattr -cr /Applications/ToriiSRS.app</code
          >
          <a
            href="/mac-help/"
            class="mt-3 inline-block text-sm font-medium text-accent-deep underline-offset-2 hover:underline"
          >
            macOS Help
          </a>
        </div>
      </div>

      <!-- Linux -->
      <div data-panel="linux" class="pt-9 text-center">
        <h3 class="font-display text-2xl font-bold text-ink">ELF Executable</h3>
        <div class="mt-6">
          {
            latest.linux.map((b) => (
              <a href={url(b)} class={btn}>
                {b.label}
                <span class="font-sans text-xs font-normal opacity-80">({size(b)})</span>
              </a>
            ))
          }
        </div>

        <div class="mx-auto mt-8 max-w-lg rounded-lg bg-surface p-5 text-left">
          <p class="text-sm">Make the file “ToriiSRS” executable after downloading:</p>
          <code
            class="mt-2 block overflow-x-auto rounded bg-dark px-3 py-2 font-mono text-sm text-white"
            >chmod +x /path/to/ToriiSRS</code
          >
        </div>
      </div>

      <!-- Android -->
      <div data-panel="android" class="pt-9 text-center">
        <h3 class="font-display text-2xl font-bold text-ink">Google Play</h3>
        <p class="mt-2 text-sm text-muted">Minimum: Android 7.0</p>
        <a href={PLAY_STORE_URL} class="mt-5 inline-block transition-transform hover:scale-105">
          <img
            src="/images/google-play-badge.png"
            alt="Get it on Google Play"
            width="646"
            height="250"
            class="h-auto w-[220px]"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- Legacy -->
  <section class="border-t border-black/5 bg-surface py-14">
    <div class="mx-auto max-w-4xl px-5">
      <h2 class="text-center font-display text-3xl font-bold text-ink">Legacy Versions</h2>

      <div class="mx-auto mt-8 max-w-2xl rounded-lg border border-black/10 bg-white p-6">
        <h3 class="font-display text-lg font-bold text-ink">
          Prerequisite — Install a Java Runtime Environment (JRE)
        </h3>
        <p class="mt-2 text-sm leading-relaxed">
          To run Torii SRS versions earlier than {LATEST_VERSION} on your desktop, you’ll need a Java
          Runtime Environment (JRE). It’s free, and installation only takes a moment. If you don’t
          have it yet, you can download it from Oracle’s official page:
        </p>
        <a
          href={JRE_DOWNLOAD_URL}
          class="mt-4 inline-block rounded-full border border-accent-deep px-6 py-2.5 font-display text-sm font-bold text-accent-deep transition-colors hover:bg-accent-deep hover:text-white"
        >
          Download Java (JRE) from Oracle
        </a>
      </div>

      <div class="mx-auto mt-8 max-w-2xl text-center">
        <h3 class="font-display text-xl font-bold text-ink">
          Torii SRS — Version {LEGACY_VERSION}
        </h3>
        <ul class="mt-5 flex flex-wrap justify-center gap-3">
          {
            legacy.map((b) => (
              <li>
                <a
                  href={url(b)}
                  class="inline-flex items-center gap-2 rounded-full border border-black/15 bg-white px-6 py-2.5 font-display text-sm font-bold text-ink transition-colors hover:border-accent hover:text-accent-deep"
                >
                  {b.label}
                  <span class="font-sans text-xs font-normal text-muted">({size(b)})</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hide every panel, then reveal the one whose radio is checked. */
  .download-tabs [data-panel] {
    display: none;
  }

  #tab-windows:checked ~ [data-panel='windows'],
  #tab-macos:checked ~ [data-panel='macos'],
  #tab-linux:checked ~ [data-panel='linux'],
  #tab-android:checked ~ [data-panel='android'] {
    display: block;
  }

  /* Active tab styling, driven by the same checked state. */
  #tab-windows:checked ~ [role='tablist'] [data-tab='windows'],
  #tab-macos:checked ~ [role='tablist'] [data-tab='macos'],
  #tab-linux:checked ~ [role='tablist'] [data-tab='linux'],
  #tab-android:checked ~ [role='tablist'] [data-tab='android'] {
    background-color: var(--color-accent);
    color: #fff;
  }

  /* Keyboard focus needs to land on the visible label, not the sr-only radio. */
  .download-tabs input:focus-visible ~ [role='tablist'] label[data-tab] {
    outline: 2px solid var(--color-accent-deep);
    outline-offset: 2px;
  }
</style>

<script is:inline>
  // /download/#macos opens that tab, and switching tabs updates the hash.
  (() => {
    const ids = ['windows', 'macos', 'linux', 'android'];

    const fromHash = location.hash.replace('#', '');
    if (ids.includes(fromHash)) {
      const input = document.getElementById(`tab-${fromHash}`);
      if (input) input.checked = true;
    }

    ids.forEach((id) => {
      document.getElementById(`tab-${id}`)?.addEventListener('change', (e) => {
        if (e.target.checked) history.replaceState(null, '', `#${id}`);
      });
    });
  })();
</script>
