---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!-- Mirrors the original theme's page banner with its Home > Page breadcrumb. -->
<section class="bg-dark py-12">
  <div class="mx-auto max-w-6xl px-5 text-center">
    <h1 class="font-display text-3xl font-bold text-white sm:text-4xl">{title}</h1>
    <nav aria-label="Breadcrumb" class="mt-3 text-sm text-white/60">
      <a href="/" class="underline-offset-2 transition-colors hover:text-accent hover:underline">
        Home
      </a>
      <span class="mx-2" aria-hidden="true">&rsaquo;</span>
      <span aria-current="page">{title}</span>
    </nav>
  </div>
</section>
