---
/*
 * Inline stroke SVGs redrawn from the icon-font glyphs the original site used
 * (Pe-icon-7-stroke, simple-line-icons, themify, Font Awesome). Names map to the
 * original classes:
 *
 *   study: pe-7s-study            directions: icon-directions
 *   audio: fa-volume-up           note: icon-note
 *   thought: ti-thought           font: fa-font
 *   stats: ti-stats-up            desktop: fa-desktop
 *   cloudSync: pe-7s-refresh-cloud
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width="48"
  height="48"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'study' && (
      <>
        <path d="M3 5.5A1.5 1.5 0 0 1 4.5 4H9a3 3 0 0 1 3 3v12a2.5 2.5 0 0 0-2.5-2.5H3z" />
        <path d="M21 5.5A1.5 1.5 0 0 0 19.5 4H15a3 3 0 0 0-3 3v12a2.5 2.5 0 0 1 2.5-2.5H21z" />
      </>
    )
  }
  {
    name === 'directions' && (
      <>
        <path d="M7 8H4l3-3v6" />
        <path d="M4 8h13a3 3 0 0 1 3 3v1" />
        <path d="M17 16h3l-3 3v-6" />
        <path d="M20 16H7a3 3 0 0 1-3-3v-1" />
      </>
    )
  }
  {
    name === 'audio' && (
      <>
        <path d="M4 9.5h3L11 6v12l-4-3.5H4z" />
        <path d="M15 9a4 4 0 0 1 0 6" />
        <path d="M17.8 6.5a7.5 7.5 0 0 1 0 11" />
      </>
    )
  }
  {
    name === 'note' && (
      <>
        <path d="M13 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-6" />
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L13 13l-3.5.5L10 10z" />
      </>
    )
  }
  {
    name === 'thought' && (
      <>
        <path d="M8 15.5a4 4 0 0 1-.6-7.95 4 4 0 0 1 7.3-2.2 3.5 3.5 0 0 1 4.6 4.75A3.5 3.5 0 0 1 17 15.5z" />
        <circle cx="7" cy="18.5" r="1.4" />
        <circle cx="3.6" cy="20.8" r="0.9" />
      </>
    )
  }
  {
    name === 'font' && (
      <>
        <path d="M5 19 11.2 5h1.6L19 19" />
        <path d="M7.6 14h8.8" />
      </>
    )
  }
  {
    name === 'stats' && (
      <>
        <path d="M4 20V10" />
        <path d="M9.3 20V14" />
        <path d="M14.7 20v-8" />
        <path d="M20 20V7" />
        <path d="m14 6 6-2-1.6 5.4" />
      </>
    )
  }
  {
    name === 'desktop' && (
      <>
        <rect x="2.5" y="4" width="19" height="12.5" rx="1.5" />
        <path d="M9 20h6" />
        <path d="M12 16.5V20" />
      </>
    )
  }
  {
    name === 'cloudSync' && (
      <>
        <path d="M7 18.5a4 4 0 0 1-.4-7.98 5 5 0 0 1 9.6-1.4A3.75 3.75 0 0 1 17.5 18.5z" />
        <path d="M9.8 13.6a2.6 2.6 0 0 1 4.3-1.3l.8.8" />
        <path d="M15.2 15.1a2.6 2.6 0 0 1-4.3 1.3l-.8-.8" />
        <path d="M15.2 11.4v1.7h-1.7" />
        <path d="M9.8 16.8v-1.7h1.7" />
      </>
    )
  }
</svg>
