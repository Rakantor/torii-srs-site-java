---
// Replaces the original Smart Slider 3 carousel that sat beside the intro copy.
// Manual advance only (the original did not autoplay): arrows, dots and arrow keys.
// Clicking a slide opens it full size in a native <dialog>.
const shots = [
  { file: 'showcase_001.png', caption: "Torii's Dashboard." },
  { file: 'showcase_002.png', caption: 'Study Interface.' },
  { file: 'showcase_003.png', caption: 'Add notes and synonyms.' },
  { file: 'showcase_004.png', caption: 'Review Interface.' },
  { file: 'showcase_005.png', caption: 'Font randomization demo.' },
  { file: 'showcase_006.png', caption: 'Wrong answer demo.' },
  { file: 'showcase_007.png', caption: 'Correct answer demo.' },
  { file: 'showcase_008.png', caption: 'Progress Interface.' },
];

const navBtn =
  'grid h-9 w-9 place-items-center rounded-full bg-white/95 text-ink shadow-md transition hover:bg-white hover:scale-105';
---

<div class="slideshow" data-slideshow>
  <div
    class="group relative overflow-hidden rounded-xl border border-black/5 bg-white shadow-sm"
    role="region"
    aria-roledescription="carousel"
    aria-label="Torii SRS screenshots"
  >
    <div class="relative aspect-[810/838]">
      {
        shots.map((shot, i) => (
          <button
            type="button"
            data-slide={i}
            class="slide absolute inset-0 h-full w-full cursor-zoom-in"
            aria-label={`${shot.caption} (${i + 1} of ${shots.length}) - click to enlarge`}
            aria-hidden={i === 0 ? undefined : 'true'}
            tabindex={i === 0 ? undefined : '-1'}
          >
            <img
              src={`/images/${shot.file}`}
              alt={shot.caption}
              width="810"
              height="838"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover"
            />
          </button>
        ))
      }
    </div>

    <button type="button" data-step="-1" class={`${navBtn} absolute top-1/2 left-2 -translate-y-1/2`} aria-label="Previous screenshot">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="m15 18-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <button type="button" data-step="1" class={`${navBtn} absolute top-1/2 right-2 -translate-y-1/2`} aria-label="Next screenshot">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="m9 18 6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <p data-caption class="mt-3 text-center text-sm text-body">{shots[0].caption}</p>

  <div class="mt-3 flex justify-center gap-2" role="tablist" aria-label="Choose screenshot">
    {
      shots.map((shot, i) => (
        <button
          type="button"
          data-dot={i}
          role="tab"
          aria-label={shot.caption}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="dot h-2.5 w-2.5 rounded-full bg-black/15 transition hover:bg-black/30"
        />
      ))
    }
  </div>
</div>

<dialog id="shot-lightbox" class="m-auto max-w-[min(94vw,860px)] rounded-xl bg-transparent p-0 backdrop:bg-black/80" aria-label="Screenshot viewer">
  <div class="relative rounded-xl bg-white p-3 shadow-2xl">
    <img id="shot-lightbox-img" alt="" width="810" height="838" class="h-auto w-full rounded-lg" />
    <p id="shot-lightbox-cap" class="px-2 py-3 text-center text-sm text-body"></p>
    <button
      type="button"
      data-close
      class="absolute -top-3 -right-3 grid h-9 w-9 place-items-center rounded-full bg-dark text-white shadow-lg transition-colors hover:bg-black"
      aria-label="Close"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</dialog>

<style>
  .slideshow .slide {
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  .slideshow .slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Without JS every slide would stack invisibly, so show the first one. */
  .slideshow:not([data-ready]) .slide:first-child {
    opacity: 1;
    pointer-events: auto;
  }

  .slideshow .dot.is-active {
    background-color: var(--color-accent);
    width: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .slideshow .slide {
      transition: none;
    }
  }
</style>

<script is:inline define:vars={{ shots }}>
  (() => {
    const root = document.querySelector('[data-slideshow]');
    if (!root) return;

    const slides = [...root.querySelectorAll('.slide')];
    const dots = [...root.querySelectorAll('.dot')];
    const caption = root.querySelector('[data-caption]');
    const dialog = document.getElementById('shot-lightbox');
    const lightboxImg = document.getElementById('shot-lightbox-img');
    const lightboxCap = document.getElementById('shot-lightbox-cap');

    let current = 0;
    root.setAttribute('data-ready', '');

    const show = (i) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((slide, n) => {
        const on = n === current;
        slide.classList.toggle('is-active', on);
        // Keep hidden slides out of the tab order and the accessibility tree.
        slide.toggleAttribute('aria-hidden', !on);
        slide.tabIndex = on ? 0 : -1;
      });
      dots.forEach((dot, n) => {
        dot.classList.toggle('is-active', n === current);
        dot.setAttribute('aria-selected', n === current ? 'true' : 'false');
      });
      caption.textContent = shots[current].caption;
    };

    root.querySelectorAll('[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => show(current + Number(btn.dataset.step)));
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => show(Number(dot.dataset.dot)));
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(current - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(current + 1);
      }
    });

    slides.forEach((slide) => {
      slide.addEventListener('click', () => {
        const shot = shots[current];
        lightboxImg.src = `/images/${shot.file}`;
        lightboxImg.alt = shot.caption;
        lightboxCap.textContent = shot.caption;
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    show(0);
  })();
</script>
