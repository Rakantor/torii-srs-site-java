---
// Shared typography wrapper for the text-heavy pages ported from WordPress.
---

<div class="prose-body">
  <slot />
</div>

<style is:global>
  .prose-body {
    color: var(--color-body);
    line-height: 1.75;
  }

  .prose-body p {
    margin-bottom: 1.1rem;
  }

  .prose-body h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .prose-body h2:first-child {
    margin-top: 0;
  }

  .prose-body h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .prose-body ul,
  .prose-body ol {
    margin-bottom: 1.1rem;
    padding-left: 1.4rem;
  }

  .prose-body ul {
    list-style: disc;
  }

  .prose-body ol {
    list-style: decimal;
  }

  .prose-body li {
    margin-bottom: 0.45rem;
  }

  .prose-body a {
    color: var(--color-accent-deep);
    text-underline-offset: 2px;
    text-decoration: underline;
  }

  .prose-body a:hover {
    color: var(--color-accent-dark);
  }

  .prose-body strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .prose-body code {
    display: inline-block;
    background: var(--color-dark);
    color: #fff;
    border-radius: 0.25rem;
    padding: 0.15rem 0.45rem;
    font-size: 0.9em;
  }

  .prose-body img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .prose-body table {
    width: 100%;
    margin-bottom: 1.1rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .prose-body th,
  .prose-body td {
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose-body th {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
