# Cloudflare Pages redirects. Preserves inbound links from the WordPress site.
# Format: <from> <to> <status>

# Canonical trailing slashes. The build emits directory-style pages (/mac-help/),
# and these make the bare form resolve too rather than 404, without depending on
# the host's default trailing-slash handling.
/download                 /download/                     301
/release-notes            /release-notes/                301
/frequently-asked-questions /frequently-asked-questions/ 301
/mac-help                 /mac-help/                     301
/about                    /about/                        301
/privacy                  /privacy/                      301

