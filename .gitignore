# build output
dist/
.astro/

# local Miniflare state from `wrangler pages dev` - scratch only, regenerated on demand
.wrangler/

# dependencies - pnpm is the package manager, pnpm-lock.yaml is the only lockfile
node_modules/
package-lock.json
yarn.lock

# local copies of the installers - ~250MB. These are served from Cloudflare R2,
# never from git or the web server. See R2-UPLOAD.md.
binaries/

# environment
.env
.env.production

# editor / os
.DS_Store
.vscode/
*.log
