# .htaccess for the torii-srs.com document root.
#
# This document root is shared: the static site lives alongside the API and the
# app's own resources (vocab.json, version, knowledge-base, system-notification,
# transaction-*.html, img_files/, icns/, font_files/, audio_files/). Nothing here
# should touch those.
#
# Replaces public/_redirects and public/_headers, which are Cloudflare Pages
# formats and are ignored by Apache.
#
# Requires: mod_rewrite, mod_headers, mod_alias, mod_dir
#   sudo a2enmod rewrite headers alias dir && sudo systemctl reload apache2

# No directory listings (kept from the previous Really Simple Security block).
Options -Indexes

# index.php stays in the list for anything under /api/ that relies on a PHP
# index. The WordPress index.php at the document root should be deleted.
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nothing to do with WordPress: exposes the Authorization header to CGI/FastCGI.
  # /api/v1/ and /api/v2/ each set this for themselves, so they do not depend on
  # it, but it costs nothing and covers anything added later without its own
  # .htaccess. Keep it.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# The WordPress front controller that used to live here:
#
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteRule . /index.php [L]
#
# is deliberately gone. It sent every unmatched URL into WordPress; with WordPress
# removed it would 500, and while present it overrides the 404 page below.
#
# Removing it does not affect the API: mod_rewrite rules are not inherited into a
# subdirectory that switches on its own RewriteEngine (absent RewriteOptions
# Inherit), and both /api/v1/ and /api/v2/ do exactly that. They never saw these
# rules in the first place.

# mod_dir's DirectorySlash (on by default) already 301s /mac-help -> /mac-help/,
# because each page is a directory containing index.html.

# Safe for the API. /api/v1/ and /api/v2/ each have their own .htaccess with a
# front controller (`RewriteRule ^(.*)$ index.php`), so PHP handles every request
# in those subtrees and emits its own 404 body. Apache only substitutes an
# ErrorDocument when it generates the error itself, which never happens there.
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Redirects from the old WordPress URLs
# ---------------------------------------------------------------------------
<IfModule mod_alias.c>
  # WordPress home slug
  Redirect 301 /home-startup/ /
  Redirect 301 /home-startup  /

  # Individual changelog posts are now anchors on one page
  Redirect 301 /2025/11/20/version-1-4-9/ /release-notes/#v1-4-9
  Redirect 301 /2020/05/07/version-1-4-8/ /release-notes/#v1-4-8
  Redirect 301 /2020/05/03/version-1-4-7/ /release-notes/#v1-4-7
  Redirect 301 /2019/12/13/version-1-4-5/ /release-notes/#v1-4-5
  Redirect 301 /2019/09/10/version-1-4-1/ /release-notes/#v1-4-1
  Redirect 301 /2019/09/09/version-1-4-0/ /release-notes/#v1-4-0
  Redirect 301 /2019/04/26/version-1-3-5/ /release-notes/#v1-3-5
  Redirect 301 /2019/03/18/version-1-3-0/ /release-notes/#v1-3-0
  Redirect 301 /2019/01/23/version-1-2-6/ /release-notes/#v1-2-6
  Redirect 301 /2018/12/22/version-1-2-5/ /release-notes/#v1-2-5
  Redirect 301 /2018/10/18/version-1-2-0/ /release-notes/#v1-2-0
  Redirect 301 /2018/06/24/version-1-1-1/ /release-notes/#v1-1-1
  Redirect 301 /2018/06/23/version-1-1-0-june-23-2018/ /release-notes/#v1-1-0
  Redirect 301 /2018/06/10/version-1-0-1-june-10-2018/ /release-notes/#v1-0-1

  # Archives, pagination, author, feed
  Redirect 301 /category/changelog/ /release-notes/
  Redirect 301 /author/rakantor/    /about/
  Redirect 301 /feed/               /release-notes/
  RedirectMatch 301 ^/release-notes/page/.*$ /release-notes/

  # Old admin endpoints
  RedirectMatch 301 ^/wp-admin(/.*)?$ /
  Redirect 301 /wp-login.php /

  # Installers now live in Cloudflare R2. Keeps links published while the site
  # ran on WordPress working after wp/ is deleted.
  RedirectMatch 301 ^/wp/wp-content/uploads/2025/11/(.*)$ https://dl.torii-srs.com/v1.4.9/$1
  RedirectMatch 301 ^/wp/wp-content/uploads/2020/05/(.*)$ https://dl.torii-srs.com/v1.4.8/$1
</IfModule>

# ---------------------------------------------------------------------------
# Caching and headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Fingerprinted build output never changes under a given name.
  SetEnvIf Request_URI "^/_astro/" TORII_IMMUTABLE=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=TORII_IMMUTABLE

  # Site images are stable but not fingerprinted.
  SetEnvIf Request_URI "^/images/" TORII_IMAGE=1
  Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" env=TORII_IMAGE

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Was `".(eot|ttf|otf|woff)"` - the dot was unescaped (matching any character)
  # and woff2 was missing, which is the format this site actually serves.
  <FilesMatch "\.(eot|ttf|otf|woff2?)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Cloudflare Pages artefacts, if they were uploaded. Harmless but not public.
<FilesMatch "^(_redirects|_headers)$">
  Require all denied
</FilesMatch>
